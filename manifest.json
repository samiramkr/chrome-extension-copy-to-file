{
  "manifest_version": 3,
  "name": "Save to Google Docs",
  "version": "1.0.0",
  "description": "Select text on any webpage and save it to your Google Doc with source URL and timestamp.",
  "permissions": [
    "identity",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://docs.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "42938059327-if9ht49cdkj94lelpr2sandjrq5fj28h.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "save-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save selected text to Google Docs"
    }
  }
}
